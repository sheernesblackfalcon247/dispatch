# ─────────────────────────────────────────────────────────────────────────────
# Black Falcon 247 Taxi — environment
#
# Copy to `.env.local` for development, or paste into the hosting dashboard.
# Every value below is a placeholder; nothing real belongs in this file, which
# IS committed. Real keys go in `.env.local`, which is not.
#
# Standing up a fresh instance? Build the database first — see db/README.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# URL and anon key: Project Settings → API. The anon key is public by design;
# row-level security is what protects the data, not the key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: Project Settings → API Keys → service_role → Reveal.
# Bypasses row-level security completely. Server-side only — never expose it,
# and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# The `api_key` of the row in `websites` this deployment serves.
# `insert into websites (name, slug) values ('Main Website', 'main');` then read
# back the generated key.
WIDGET_API_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Used to build SumUp return URLs and the
# links in customer emails, so it must match the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Maps ──────────────────────────────────────────────────────────────
# One key, server-side only — it never reaches the browser (the maps are drawn
# on OpenStreetMap). In Google Cloud enable Places API (New) and Routes API,
# restrict the key to those two, and set a daily quota cap. Do NOT give it a
# NEXT_PUBLIC_ prefix: that would publish it in the page.
GOOGLE_MAPS_API_KEY=

# ── Payments (optional) ──────────────────────────────────────────────────────
# Card payments stay OFF unless this is exactly "on". With it off the booking
# form offers cash to driver only, and the checkout API refuses to start a
# session even if called directly.
NEXT_PUBLIC_CARD_PAYMENTS=off

# SumUp. Create an API key at SumUp Dashboard → Developers → API keys (it starts
# sup_sk_…). Test with a sandbox merchant account first.
SUMUP_API_KEY=

# The merchant code card payments are paid to (e.g. MCXXXXXX), shown in the
# SumUp Dashboard under your profile.
SUMUP_MERCHANT_CODE=

# Nothing to set up for notifications: every checkout tells SumUp to notify
# https://your-domain/api/webhooks/sumup, which is what makes the booking for a
# customer who pays and then closes the tab. NEXT_PUBLIC_SITE_URL must be right.

# ── Email (optional) ─────────────────────────────────────────────────────────
# Booking confirmations and staff invites. Without a key, email is skipped and
# the booking still succeeds.
RESEND_API_KEY=
# Must be an address at a domain verified in Resend.
EMAIL_FROM=bookings@your-domain.co.uk

# ── SMS (optional) ───────────────────────────────────────────────────────────
COSMICSMS_USERNAME=
COSMICSMS_API_PASSWORD=
COSMICSMS_SENDER=

# ── Keep-alive cron ──────────────────────────────────────────────────────────
# vercel.json runs /api/cron/keepalive once a day so a free-tier Supabase
# project is never paused for inactivity. Vercel sends this value as a Bearer
# token on cron calls; the route refuses any request without it. Any long
# random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
